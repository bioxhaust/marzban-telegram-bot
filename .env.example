BOT_TOKEN=replace_with_bot_token
ADMIN_TELEGRAM_ID=123456789
# Сколько последних message_id просматривать при /admin_wipe (50–2000)
# ADMIN_WIPE_LOOKBACK=400
# Подряд не удалось удалить — выходим из цикла (меньше шума в логах)
# ADMIN_WIPE_FAIL_STREAK=22
DB_PATH=./vpnbot.db

MARZBAN_BASE_URL=https://your-panel.example:8000
MARZBAN_ADMIN_USERNAME=replace_admin_username
MARZBAN_ADMIN_PASSWORD=replace_admin_password
MARZBAN_SUBSCRIPTION_URL_PREFIX=https://your-panel.example:8000
MARZBAN_INBOUND_TAGS=

# Поддержка в боте (кнопка и t.me ссылка). Без @
# SUPPORT_TELEGRAM_USERNAME=your_support_username

# Crypto Pay (@CryptoBot): https://t.me/CryptoBot → Crypto Pay → Create App → API token
# Если задано — кнопки оплаты выставляют счёт; без токена — тестовая выдача без оплаты.
# CRYPTO_PAY_API_TOKEN=
# CRYPTO_PAY_TESTNET=0
# CRYPTO_FIAT=USD
# CRYPTO_PRICE_PER_MONTH=2
# CRYPTO_DISCOUNT_3M_PCT=5
# CRYPTO_DISCOUNT_6M_PCT=10
# CRYPTO_DISCOUNT_12M_PCT=20
# CRYPTO_POLL_INTERVAL=15

# Режим оплаты: auto — Crypto Pay (если токен) + Stars + реф. баланс; crypto — только Crypto Pay.
# PAYMENT_PROVIDER=auto
# Тариф в интерфейсе бота (₽/мес):
# TARIFF_CURRENCY=RUB
# TARIFF_PRICE_PER_MONTH_RUB=200

# Telegram Stars: @BotFather → Bot Settings → Payments → Telegram Stars
# TELEGRAM_STARS_ENABLED=1
# STARS_RUB_PARITY=2.5

# Рефералка
# INVITES_PER_SUB_MONTH=3
# REFERRAL_COMMISSION_PCT=15
